# LH4051-DE Arch Linux package template
pkgname=lh4051-de-git
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Longhorn 4051-inspired desktop environment'
arch=('@ARCH@')
url='https://github.com/kuznix-code/LH4051-DE'
license=('GPL-3.0-or-later')
depends=('gtk4' 'gtk4-layer-shell')
makedepends=('git' 'base-devel' 'pkg-config')
provides=('lh4051-de')
conflicts=('lh4051-de')
source=("git+https://github.com/kuznix-code/LH4051-DE.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/LH4051-DE"
    printf '%s' "$(git describe --tags --abbrev=0 2>/dev/null || echo 0)"
    # This function is replaced by make dist-stable for stable releases.
}

prepare() {
    cd "$srcdir/LH4051-DE"
    git config --global --add safe.directory "$PWD"
    # Ensure clean generated build data exists before packaging.
    make clean >/dev/null 2>&1 || true
}

build() {
    cd "$srcdir/LH4051-DE"
    make TARGET=linux-arch-x86_64 all sessions data
}

package() {
    cd "$srcdir/LH4051-DE"
    make DESTDIR="$pkgdir" PREFIX="/usr" install
}

# Stable release packaging override:
#   make dist-stable
#   PKGBUILD generated with pkgver @VERSION@ and no git-snapshot metadata

#!/bin/sh
# LH4051-DE bootstrap: build the LATEST GTK 4 and every library it needs from source.
#
# For systems that have no GTK 4 development files and no package manager to supply them: Linux From Scratch (LFS),
# minimal chroots, unusual CPU architectures. lh4051-de-updater runs this automatically (--bootstrap, or when it finds
# GTK 4.10+ missing and the system is LFS); it can also be run by hand:
#
#   lh4051-de-bootstrap [--prefix DIR] [--workdir DIR] [--jobs N] [--env-file FILE] [--yes]
#                       [--list] [--only a,b] [--skip a,b] [--no-x11] [--no-wayland] [--no-gl] [--no-layer-shell]
#                       [NAME=value ...]
#
#   --prefix DIR     install everything here (default /usr/local; use /usr on a classic LFS)
#   --workdir DIR    downloads, sources, logs and "done" stamps (default /var/tmp/lh4051-de-bootstrap); rerunning
#                    resumes after the last finished package
#   --list           resolve and print the latest version and URL of every package, build nothing
#   --only/--skip    comma separated package names (see --list)
#   --no-x11         no X11 backend (Wayland only);  --no-wayland: no Wayland backend
#   --no-gl          no libglvnd (GTK then needs a GL driver you install yourself, or GSK_RENDERER=cairo)
#   NAME=value       exported to the builds, e.g. CC=gcc
#   <PKG>_VERSION=x  pin one package (e.g. GLIB_VERSION=2.84.4, XORGPROTO_VERSION=2024.1) if the newest one breaks
#   GH_TOKEN         optional GitHub token (raises the API rate limit for the version lookups)
#
# Order: pkgconf, ninja, meson (+cmake) -> zlib, libffi, pcre2, expat, libxml2, GLib, shared-mime-info -> FreeType,
# HarfBuzz, FriBidi, Fontconfig, fonts -> libpng, libjpeg-turbo, pixman -> X11 libraries -> Cairo, Pango, gdk-pixbuf,
# Graphene -> libglvnd, libepoxy, xkbcommon -> Wayland -> icon themes -> GTK 4 -> gtk4-layer-shell.
# Needs: a C and C++ compiler, GNU make, tar with xz/bz2/gz, python3, curl or wget, sh, sed, awk, grep, bison
# (libxkbcommon), and roughly 4 GB of disk. Expect hours on slow machines. Mesa is NOT built: GTK falls back to its
# Cairo renderer until a GL driver is installed. Not every upstream combination can be tested; if a package fails,
# its log is in <workdir>/logs and the build can be resumed or pinned with <PKG>_VERSION.
set -eu

PREFIX=/usr/local
WORK=/var/tmp/lh4051-de-bootstrap
JOBS=""
ENVFILE=""
YES=0
LIST=0
ONLY=""
SKIP=""
X11=1
WAYLAND=1
GL=1
LAYER=1

say()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0; }

while [ $# -gt 0 ]; do
    case "$1" in
        --prefix)    [ $# -ge 2 ] || die "--prefix needs a value"; PREFIX="$2"; shift ;;
        --prefix=*)  PREFIX="${1#--prefix=}" ;;
        --workdir)   [ $# -ge 2 ] || die "--workdir needs a value"; WORK="$2"; shift ;;
        --workdir=*) WORK="${1#--workdir=}" ;;
        --jobs|-j)   [ $# -ge 2 ] || die "--jobs needs a value"; JOBS="$2"; shift ;;
        --env-file)  [ $# -ge 2 ] || die "--env-file needs a value"; ENVFILE="$2"; shift ;;
        -y|--yes)    YES=1 ;;
        --list)      LIST=1 ;;
        --only)      [ $# -ge 2 ] || die "--only needs a value"; ONLY="$(printf '%s' "$2" | tr ',' ' ')"; shift ;;
        --skip)      [ $# -ge 2 ] || die "--skip needs a value"; SKIP="$(printf '%s' "$2" | tr ',' ' ')"; shift ;;
        --no-x11)    X11=0 ;;
        --no-wayland) WAYLAND=0 ;;
        --no-gl)     GL=0 ;;
        --no-layer-shell) LAYER=0 ;;
        -h|--help)   usage ;;
        [A-Za-z_]*=*) export "$1" ;;
        *) die "unknown option: $1 (try --help)" ;;
    esac
    shift
done
[ "$X11" = 1 ] || [ "$WAYLAND" = 1 ] || die "at least one of the X11 and Wayland backends is needed"
[ -n "$JOBS" ] || JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
case "$PREFIX" in /*) ;; *) die "--prefix must be an absolute path" ;; esac
mkdir -p "$WORK/dl" "$WORK/src" "$WORK/logs" "$WORK/stamps" "$WORK/idx" 2>/dev/null || die "cannot create $WORK"

# ---------------------------------------------------------------- environment for all builds
PYVER=""
if have python3; then PYVER="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true)"; fi
export PATH="$PREFIX/bin:$PATH"
export PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig:$PREFIX/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CPPFLAGS="-I$PREFIX/include${CPPFLAGS:+ $CPPFLAGS}"
export LDFLAGS="-L$PREFIX/lib -Wl,-rpath,$PREFIX/lib${LDFLAGS:+ $LDFLAGS}"
export ACLOCAL_PATH="$PREFIX/share/aclocal${ACLOCAL_PATH:+:$ACLOCAL_PATH}"
export XDG_DATA_DIRS="$PREFIX/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
[ -n "$PYVER" ] && export PYTHONPATH="$PREFIX/lib/python$PYVER/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export CFLAGS="${CFLAGS:--O2}"
export CXXFLAGS="${CXXFLAGS:--O2}"

# ---------------------------------------------------------------- downloads and version lookup
fetch() { # fetch URL OUTFILE
    _tries=0
    while [ "$_tries" -lt 3 ]; do
        if have curl; then
            if [ -n "${GH_TOKEN:-}" ] && case "$1" in https://api.github.com/*) true ;; *) false ;; esac; then
                curl -fsSL -H "Authorization: Bearer $GH_TOKEN" -o "$2" "$1" && return 0
            else curl -fsSL -o "$2" "$1" && return 0; fi
        elif have wget; then wget -q -O "$2" "$1" && return 0
        else die "need curl or wget"; fi
        _tries=$((_tries + 1)); sleep 2
    done
    return 1
}

cached() { # cached URL -> prints the path of a (cached) copy of the page
    _f="$WORK/idx/$(printf '%s' "$1" | cksum | tr ' ' '_')"
    [ -s "$_f" ] || fetch "$1" "$_f" || { rm -f "$_f"; return 1; }
    printf '%s' "$_f"
}

vsort_last() { sort -t. -k1,1n -k2,2n -k3,3n -k4,4n -k5,5n | tail -n 1; }
only_even_minor() { awk '{ n = split($0, a, "."); if (n < 2 || a[2] % 2 == 0) print }'; }

# hrefs PAGE -> the last path component of every link
hrefs() { grep -Eo 'href="[^"?#]+"' "$1" | sed 's/^href="//; s/"$//; s|/$||; s|.*/||'; }

idx_latest() { # idx_latest URL PREFIX EXT EVEN
    page="$(cached "$1")" || return 1
    list="$(hrefs "$page" | sed -n "s/^$2\([0-9][0-9.]*\)\.$3\$/\1/p")"
    [ "$4" = even ] && list="$(printf '%s\n' "$list" | only_even_minor)"
    printf '%s\n' "$list" | grep . | vsort_last
}

gnome_resolve() { # gnome_resolve NAME EVEN -> sets V and U
    page="$(cached "https://download.gnome.org/sources/$1/")" || return 1
    dirs="$(hrefs "$page" | grep -E '^[0-9]+(\.[0-9]+)?$')"
    [ "$2" = even ] && dirs="$(printf '%s\n' "$dirs" | only_even_minor)"
    dir="$(printf '%s\n' "$dirs" | grep . | vsort_last)"
    [ -n "$dir" ] || return 1
    page="$(cached "https://download.gnome.org/sources/$1/$dir/")" || return 1
    V="$(hrefs "$page" | sed -n "s/^$1-\([0-9][0-9.]*\)\.tar\.xz\$/\1/p" | grep . | vsort_last)"
    U="https://download.gnome.org/sources/$1/$dir/$1-$V.tar.xz"
}

json_names() { # json_names FILE -> tag names of a GitHub/GitLab tag list
    python3 -c 'import json, sys
for t in json.load(open(sys.argv[1])): print(t.get("name", ""))' "$1"
}

tags_resolve() { # tags_resolve KIND PROJECT TAGPREFIX TAGFMT URLTEMPLATE
    case "$1" in
        gh) page="$(cached "https://api.github.com/repos/$2/tags?per_page=100")" || return 1 ;;
        gl) enc="$(printf '%s' "$2" | sed 's|/|%2F|g')"
            page="$(cached "https://gitlab.freedesktop.org/api/v4/projects/$enc/repository/tags?per_page=100")" || return 1 ;;
    esac
    pre="$3"; [ "$pre" = - ] && pre=""
    T="$(json_names "$page" | grep -E "^$pre[0-9]+([._][0-9]+)*\$" | sed "s/^$pre//; s/_/./g" | vsort_last)"
    [ -n "$T" ] || return 1
    V="$T"
    [ "$4" = us ] && T="$(printf '%s' "$T" | tr '.' '_')"
    T="$pre$T"
    U="$(printf '%s' "$5" | sed "s|@T@|$T|g; s|@V@|$V|g")"
}

# name kind args...   (kinds: idx URL PREFIX EXT even|any / gnome NAME even|any / gh|gl PROJECT TAGPREFIX dot|us URL / fixed VER URL)
TABLE="

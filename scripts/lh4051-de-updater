#!/bin/sh
# LH4051-DE Updater (Linux, macOS, FreeBSD and other unix-like systems)
#
#   lh4051-de-updater [--mode MODE] [--check] [--yes] [--force] [--source] [--bootstrap] [--prefix DIR]
#
# Modes (default: stable; also LH4051_UPDATE_MODE or "mode=..." in ~/.config/lh4051-de/updater.conf)
#   stable         newest stable release
#   beta           newest beta (GitHub prerelease)
#   lts            newest release of the newest LTS line
#   lts-0.1        newest release of one LTS line (0.1.x)
#   lts-0.1.1      one exact release of an LTS line
#   0.1.1          one exact release (only supported releases, see docs/supported-releases.txt)
#   dev            build of the latest successful CI run on main:      <version>.YYYYMMDD.<commit>
#   stable-dev     ... on the stable branch
#   beta-dev       ... on the beta branch
#   lts-dev        ... on the lts branch
#   0.1-dev        ... on the branch that carries release line 0.1
#
# x86-64 variants (Linux, glibc): the default build is the baseline (v1) that runs on every x86-64 PC. Faster builds
# for newer CPUs are chosen explicitly, never automatically:  --variant v2|v3|v4|zen4  (or  MODE:VARIANT, e.g. stable:v3,
# or LH4051_UPDATE_VARIANT, or "variant=v3" in the config file). The CPU is checked first.
#   v2    SSE4.2, POPCNT          (Nehalem / 2009+)
#   v3    AVX2, BMI2, FMA         (Haswell / Zen 1 and newer)
#   v4    AVX-512                 (Skylake-X / Zen 4 and newer)
#   zen4  tuned for AMD Zen 4+    (needs AVX-512 incl. BF16)
# musl systems (Alpine) are detected automatically; override with LH4051_LIBC=glibc|musl.
#
# Dev builds ("dev", "stable-dev", ...) come from the rolling CI release of the branch (tag ci-<branch>), which needs no
# token. If that release does not exist yet, the updater falls back to the raw GitHub Actions artifacts (they need
# `gh auth login` or GH_TOKEN) and finally to building the branch from source.
# "stable" / "lts" follow tagged releases; while the line has none yet (no vX.Y.Z tag has been published) the updater
# uses the newest CI build of that line's branch instead and says so.
#
# Installer kind per OS:
#   Linux / FreeBSD               LH4051-DE-Installer-<ver>-linux-[musl-]<arch>[-<variant>].run
#   macOS                         LH4051-DE-Installer-<ver>-macos-<arch>.pkg
#   any other OS or architecture (or --source): download the source and build it.
#   That needs GTK 4.10+ development files, a C compiler, GNU Make and pkg-config.
#   Prebuilt installers exist for: Linux glibc x86_64 (+v2/v3/v4/zen4), arm64, i686, armv7, riscv64, ppc64el, s390x;
#   Linux musl x86_64, i686, arm64; macOS x86_64/arm64; FreeBSD x86_64. Everything else is built from source.
#
# Linux From Scratch and other systems without GTK 4: --bootstrap (also offered automatically when GTK 4.10+ is
# missing, and implied on LFS) first builds the latest versions of GTK 4 and everything it needs (zlib, libffi, GLib,
# FreeType, HarfBuzz, Pango, Cairo, X11/Wayland libraries, ...) with scripts/lh4051-de-bootstrap from the source tree,
# installs them under --prefix (default /usr/local), and then builds LH4051-DE itself.
set -eu

REPO="kuznix-code/LH4051-DE"
API="${LH4051_API:-https://api.github.com/repos/$REPO}"
RAW="${LH4051_RAW:-https://raw.githubusercontent.com/$REPO}"
MODE=""
CHECK=0
YES=0
FORCE=0
FORCE_SOURCE=0
BOOTSTRAP=auto   # auto | 1 (--bootstrap) | 0 (--no-bootstrap)
PREFIX=""
VARIANT=""
ASSET_IS_ZIP=0   # 1 when ASSET_URL is a GitHub Actions artifact (a zip around the installer)

say()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0; }

while [ $# -gt 0 ]; do
    case "$1" in
        --mode)     [ $# -ge 2 ] || die "--mode needs a value"; MODE="$2"; shift ;;
        --mode=*)   MODE="${1#--mode=}" ;;
        --check)    CHECK=1 ;;
        -y|--yes)   YES=1 ;;
        -f|--force) FORCE=1 ;;
        --source)   FORCE_SOURCE=1 ;;
        --bootstrap) BOOTSTRAP=1; FORCE_SOURCE=1 ;;
        --no-bootstrap) BOOTSTRAP=0 ;;
        --variant)  [ $# -ge 2 ] || die "--variant needs a value"; VARIANT="$2"; shift ;;
        --variant=*) VARIANT="${1#--variant=}" ;;
        --prefix)   [ $# -ge 2 ] || die "--prefix needs a value"; PREFIX="$2"; shift ;;
        --prefix=*) PREFIX="${1#--prefix=}" ;;
        -h|--help)  usage ;;
        *) die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/lh4051-de/updater.conf"
if [ -z "$MODE" ] && [ -n "${LH4051_UPDATE_MODE:-}" ]; then MODE="$LH4051_UPDATE_MODE"; fi
if [ -z "$MODE" ] && [ -f "$CONF" ]; then
    MODE="$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([A-Za-z0-9.-]*\).*/\1/p' "$CONF" | head -n 1)"
fi
[ -n "$MODE" ] || MODE=stable
if [ -z "$VARIANT" ] && [ -n "${LH4051_UPDATE_VARIANT:-}" ]; then VARIANT="$LH4051_UPDATE_VARIANT"; fi
if [ -z "$VARIANT" ] && [ -f "$CONF" ]; then
    VARIANT="$(sed -n 's/^[[:space:]]*variant[[:space:]]*=[[:space:]]*\([A-Za-z0-9]*\).*/\1/p' "$CONF" | head -n 1)"
fi
case "$MODE" in *:*) VARIANT="${MODE#*:}"; MODE="${MODE%%:*}" ;; esac
case "$VARIANT" in ""|v1|none) VARIANT="" ;; v2|v3|v4|zen4) ;; *) die "unknown variant '$VARIANT' (v2, v3, v4 or zen4; the default build is v1)" ;; esac

# ---------------------------------------------------------------- platform
OS_RAW="$(uname -s)"
case "$OS_RAW" in
    Linux)   OS=linux ;;
    Darwin)  OS=macos ;;
    FreeBSD) OS=bsd ;;
    OpenBSD|NetBSD|DragonFly|MidnightBSD) OS=bsd ;;
    CYGWIN*|MINGW*|MSYS*) die "this is the unix updater; on Windows use lh4051-de-updater.cmd" ;;
    *)       OS=unix ;;
esac
# Architecture names follow the installer file names.
case "${LH4051_ARCH:-$(uname -m)}" in
    x86_64|amd64)            ARCH=x86_64 ;;
    i386|i486|i586|i686)     ARCH=i686 ;;
    aarch64|arm64)           ARCH=arm64 ;;
    armv7l|armv7|armv8l)     ARCH=armv7 ;;
    ppc64le|ppc64el)         ARCH=ppc64el ;;
    ppc64)                   ARCH=ppc64 ;;
    ppc|ppc32|powerpc)       ARCH=ppc ;;
    mips64|mips64el)         ARCH=mips64el ;;
    mips|mipsel)             ARCH="$(uname -m)" ;;
    riscv64)                 ARCH=riscv64 ;;
    riscv32)                 ARCH=riscv32 ;;
    s390x)                   ARCH=s390x ;;
    loongarch64)             ARCH=loongarch64 ;;
    sparc64)                 ARCH=sparc64 ;;
    alpha|ia64|m68k|sh4|hppa|hppa64|arc|or1k|microblaze) ARCH="$(uname -m)" ;;
    *)                       ARCH="${LH4051_ARCH:-$(uname -m)}" ;;
esac
LIBC=glibc
if [ "$OS_RAW" = Linux ]; then
    if [ -n "${LH4051_LIBC:-}" ]; then LIBC="$LH4051_LIBC"
    elif ls /lib/ld-musl-*.so.1 /usr/lib/ld-musl-*.so.1 >/dev/null 2>&1 || ldd --version 2>&1 | grep -qi musl; then LIBC=musl; fi
fi
case "$LIBC" in glibc|musl) ;; *) die "LH4051_LIBC must be glibc or musl" ;; esac

# CI publishes installers for Linux, macOS and FreeBSD; musl only for x86_64, i686 and arm64.
# Every other OS, libc or CPU architecture compiles from source (a missing installer also falls back to source).
BINARY_OK=0
case "$OS_RAW" in Linux|Darwin|FreeBSD) BINARY_OK=1 ;; esac
if [ "$OS_RAW" = Linux ] && [ "$LIBC" = musl ]; then
    case "$ARCH" in x86_64|i686|arm64) ;; *) BINARY_OK=0 ;; esac
fi

# No installer exists for mips64el (Debian dropped it, so CI has no container with GTK 4.10+): build from source.
[ "$OS_RAW" = Linux ] && [ "$ARCH" = mips64el ] && BINARY_OK=0

# Variants exist for glibc x86-64 only.
if [ -n "$VARIANT" ]; then
    [ "$OS_RAW" = Linux ] && [ "$ARCH" = x86_64 ] || die "variant '$VARIANT' exists for Linux x86_64 only"
    [ "$LIBC" = glibc ] || die "variant '$VARIANT' is not built for musl; use the default build"
fi

# cpu_missing VARIANT -> names the CPU features /proc/cpuinfo does not list
cpu_missing() {
    case "$1" in
        v2)   need="ssse3 sse4_1 sse4_2 popcnt cx16" ;;
        v3)   need="avx2 bmi1 bmi2 fma movbe abm f16c" ;;
        v4)   need="avx2 bmi2 fma avx512f avx512bw avx512cd avx512dq avx512vl" ;;
        zen4) need="avx2 bmi2 fma avx512f avx512bw avx512vl avx512_bf16 avx512_vbmi2" ;;
    esac
    [ -r /proc/cpuinfo ] || { echo "(cannot read /proc/cpuinfo)"; return; }
    flags="$(grep -m1 '^flags' /proc/cpuinfo | cut -d: -f2)"
    miss=""
    for f in $need; do case " $flags " in *" $f "*) ;; *) miss="$miss $f" ;; esac; done
    printf '%s' "$miss"
}
# TARGET_DESC: shown to the user; ASSET_ARCH: installer file name part; ART_SUFFIX: CI artifact name part
ASSET_ARCH="$ARCH"; ART_SUFFIX=""
case "$ARCH" in x86_64) ART_SUFFIX=x64 ;; i686) ART_SUFFIX=x86 ;; *) ART_SUFFIX="$ARCH" ;; esac
if [ -n "$VARIANT" ]; then ASSET_ARCH="$ARCH-$VARIANT"; ART_SUFFIX="$ART_SUFFIX-$VARIANT"; fi
if [ "$LIBC" = musl ]; then ASSET_ARCH="musl-$ASSET_ARCH"; ART_SUFFIX="musl-$ART_SUFFIX"; fi
TARGET_DESC="$OS_RAW/$ARCH${VARIANT:+ $VARIANT}$([ "$OS_RAW" = Linux ] && echo " ($LIBC)")"

# ---------------------------------------------------------------- helpers
TMP="$(mktemp -d 2>/dev/null || mktemp -d -t lh4051)"
trap 'rm -rf "$TMP"' EXIT INT TERM

TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [ -z "$TOKEN" ] && have gh; then TOKEN="$(gh auth token 2>/dev/null || true)"; fi

fetch() { # fetch URL OUTFILE   (the token is only sent to the GitHub API)
    url="$1"; out="$2"; auth=""
    case "$url" in "$API"*) auth="$TOKEN" ;; esac
    if have curl; then
        if [ -n "$auth" ]; then curl -fsSL -H "Authorization: Bearer $auth" -H "Accept: application/vnd.github+json" -o "$out" "$url"
        else curl -fsSL -H "Accept: application/vnd.github+json" -o "$out" "$url"; fi
    elif have wget; then
        if [ -n "$auth" ]; then wget -q --header="Authorization: Bearer $auth" -O "$out" "$url"
        else wget -q -O "$out" "$url"; fi
    elif [ "$OS_RAW" = FreeBSD ]; then
        /usr/bin/fetch -q -o "$out" "$url"
    else
        die "need curl or wget to download updates"
    fi
}

# json_get FILE JQ_EXPR PYTHON_EXPR -> one value per line
json_get() {
    if have jq; then jq -r "$2" "$1"
    elif have python3; then python3 -c "import json,sys; d=json.load(open(sys.argv[1])); r=($3); [print(x) for x in (r if isinstance(r,list) else [r]) if x is not None]" "$1"
    else die "release lookup needs jq or python3 to read GitHub's answers"; fi
}

safe_ref() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._/+-]+$' || die "unsafe name from GitHub: $1"; }

# vcmp A B -> prints -1, 0 or 1. Numbers compare numerically; dev < alpha < beta < rc < (release) < more numbers;
# a non-numeric token such as a commit hash ends the comparison.
vcmp() {
    awk -v a="${1#v}" -v b="${2#v}" '
    function val(t) {
        if (t == "") return 0
        if (t == "dev") return -4
        if (t == "alpha") return -3
        if (t == "beta") return -2
        if (t == "rc") return -1
        if (t ~ /^[0-9]+$/) return t + 0
        return "stop"
    }
    BEGIN {
        na = split(a, A, /[.-]/); nb = split(b, B, /[.-]/); n = (na > nb) ? na : nb
        for (i = 1; i <= n; i++) {
            x = val(A[i]); y = val(B[i])
            if (x == "stop" || y == "stop") { print 0; exit }
            if (x < y) { print -1; exit }
            if (x > y) { print 1; exit }
        }
        print 0
    }'
}

line_of() { printf '%s' "${1#v}" | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p'; }

confirm() {
    [ "$YES" = 1 ] && return 0
    [ -t 0 ] || die "not running interactively; pass --yes to continue"
    printf '%s [Y/n] ' "$1"
    read -r a
    case "$a" in n|N|no|NO) return 1 ;; esac
    return 0
}

# ---------------------------------------------------------------- installed version
# Prints the installed version (e.g. 0.1.1 or 0.2.0.dev.20261029.abc1234), or nothing.
installed_version() {
    for p in ${PREFIX:+"$PREFIX"} /usr/local /usr /opt/local /opt/homebrew "$HOME/.local"; do
        if [ -f "$p/share/lh4051-de/version" ]; then
            v="$(head -n 1 "$p/share/lh4051-de/version" | tr -d '[:space:]')"
            [ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
        fi
    done
    if [ "$OS" = macos ]; then
        for app in /Applications/LH4051-DE.app "$HOME/Applications/LH4051-DE.app"; do
            if [ -f "$app/Contents/Info.plist" ]; then
                v="$(defaults read "$app/Contents/Info" CFBundleShortVersionString 2>/dev/null || true)"
                [ -z "$v" ] && have /usr/libexec/PlistBuddy && v="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null || true)"
                [ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
            fi
        done
    fi
    for exe in "$(command -v lh4051-de 2>/dev/null || true)" ${PREFIX:+"$PREFIX/bin/lh4051-de"} \
               /usr/local/bin/lh4051-de /usr/bin/lh4051-de /opt/homebrew/bin/lh4051-de "$HOME/.local/bin/lh4051-de"; do
        [ -n "$exe" ] && [ -x "$exe" ] || continue
        v="$("$exe" --version 2>/dev/null | sed -n 's/^LH4051-DE //p' | head -n 1)"
        [ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
    done
    return 0
}

# ---------------------------------------------------------------- supported release lines
load_supported() {
    S="$TMP/supported.txt"
    if ! fetch "$RAW/main/docs/supported-releases.txt" "$S" 2>/dev/null || [ ! -s "$S" ]; then
        warn "could not read the supported-release list; using built-in defaults"
        printf '0.2 dev main\n0.1 stable,lts stable\n' > "$S"
    fi
    grep -v '^[[:space:]]*#' "$S" | grep -v '^[[:space:]]*$' > "$S.clean" || : > "$S.clean"
    S="$S.clean"
}
# lines_with CHANNEL -> release lines that have the channel
lines_with() { awk -v c="$1" '{ n = split($2, ch, ","); for (i = 1; i <= n; i++) if (ch[i] == c) print $1 }' "$S"; }
# branch_of_channel CHANNEL / branch_of_line LINE
branch_of_channel() { awk -v c="$1" '{ n = split($2, ch, ","); for (i = 1; i <= n; i++) if (ch[i] == c) { print $3; exit } }' "$S"; }
branch_of_line() { awk -v l="$1" '$1 == l { print $3; exit }' "$S"; }
line_has() { awk -v l="$1" -v c="$2" '$1 == l { n = split($2, ch, ","); for (i = 1; i <= n; i++) if (ch[i] == c) found = 1 } END { exit !found }' "$S"; }
line_supported() { line_has "$1" stable || line_has "$1" lts; }

# ---------------------------------------------------------------- mode
version_like() { printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+(\.[0-9]+)?(\.x)?(-[A-Za-z0-9.]+)?$'; }
is_line_arg()  { printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+(\.x)?$'; }

KIND=""; CHANNEL=""; WANT_LINE=""; WANT_EXACT=""; BRANCH=""
parse_mode() {
    case "$MODE" in
        stable|beta|lts) KIND=release; CHANNEL="$MODE" ;;
        dev)             KIND=branch;  CHANNEL=dev ;;
        stable-dev|beta-dev|lts-dev) KIND=branch; CHANNEL="${MODE%-dev}" ;;
        lts-*)
            rest="${MODE#lts-}"
            if is_line_arg "$rest"; then KIND=release; CHANNEL=lts; WANT_LINE="$(line_of "$rest")"
            elif version_like "$rest"; then KIND=exact; CHANNEL=lts; WANT_EXACT="$rest"
            else die "unknown mode '$MODE'"; fi ;;
        *-dev)
            rest="${MODE%-dev}"
            is_line_arg "$rest" || die "unknown mode '$MODE'"
            KIND=branch; WANT_LINE="$(line_of "$rest")" ;;
        *)
            version_like "$MODE" || die "unknown mode '$MODE' (stable, beta, lts, lts-0.1, 0.1.1, dev, stable-dev, beta-dev, lts-dev, 0.1-dev)"
            KIND=exact; WANT_EXACT="$MODE" ;;
    esac
}

# ---------------------------------------------------------------- lookups
TAG=""; VERSION=""; ASSET_URL=""; SRC_URL=""; SRC_NOTE=""; FALLBACK_BRANCH=0; SHA=""

asset_regex() {
    case "$OS" in
        macos) printf 'LH4051-DE-Installer-.*-macos-%s\\.pkg$' "$ARCH" ;;
        *)     printf 'LH4051-DE-Installer-.*-%s-%s\\.run$' "$OS" "$ASSET_ARCH" ;;
    esac
}

lookup_release() {
    fetch "$API/releases?per_page=100" "$TMP/rel.json" || die "could not reach GitHub (releases)"
    json_get "$TMP/rel.json" '.[]|select(.draft|not)|[.tag_name,(.prerelease|tostring)]|@tsv' \
        '["%s\t%s" % (r["tag_name"], str(r.get("prerelease", False)).lower()) for r in d if not r.get("draft")]' > "$TMP/tags.tsv"
    best=""
    while IFS="$(printf '\t')" read -r tag pre; do
        [ -n "$tag" ] || continue
        line="$(line_of "$tag")"; [ -n "$line" ] || continue
        case "$KIND:$CHANNEL" in
            exact:*)
                [ "${tag#v}" = "${WANT_EXACT#v}" ] || continue ;;
            release:beta)
                [ "$pre" = true ] || continue ;;
            release:stable)
                [ "$pre" = false ] || continue
                line_has "$line" stable || continue ;;
            release:lts)
                [ "$pre" = false ] || continue
                line_has "$line" lts || continue
                [ -z "$WANT_LINE" ] || [ "$line" = "$WANT_LINE" ] || continue ;;
        esac
        if [ -z "$best" ] || [ "$(vcmp "$tag" "$best")" = 1 ]; then best="$tag"; bestpre="$pre"; fi
    done < "$TMP/tags.tsv"

    if [ -z "$best" ]; then
        case "$KIND:$CHANNEL" in
            exact:*) die "release $WANT_EXACT does not exist" ;;
            release:stable|release:lts)
                # No vX.Y.Z tag has been released for this line yet: use the newest CI build of its branch.
                if [ -z "$WANT_LINE" ]; then BRANCH="$(branch_of_channel "$CHANNEL")"; else BRANCH="$(branch_of_line "$WANT_LINE")"; fi
                [ -n "$BRANCH" ] || die "no $CHANNEL release has been published yet, and no branch is listed for it"
                say "No $CHANNEL release has been tagged yet; using the newest CI build of the '$BRANCH' branch."
                FALLBACK_BRANCH=1
                return 0 ;;
            *) die "no $CHANNEL release has been published yet" ;;
        esac
    fi
    line="$(line_of "$best")"
    if [ "$KIND" = exact ]; then
        # only supported releases can be installed by version
        if [ "$bestpre" = true ]; then line_has "$line" beta || line_supported "$line" || die "release $best is not supported (line $line)"
        else line_supported "$line" || die "release $best is not supported: line $line is not a stable or LTS line (supported lines: $( { lines_with stable; lines_with lts; } | sort -u | tr '\n' ' '))"; fi
        if [ "$CHANNEL" = lts ]; then line_has "$line" lts || die "release $best is not part of an LTS line"; fi
    fi
    if [ "$KIND" = release ] && [ "$CHANNEL" = lts ] && [ -n "$WANT_LINE" ]; then
        line_has "$WANT_LINE" lts || die "$WANT_LINE is not an LTS line (LTS lines: $(lines_with lts | tr '\n' ' '))"
    fi
    TAG="$best"; safe_ref "$TAG"; VERSION="${TAG#v}"
    json_get "$TMP/rel.json" ".[]|select(.tag_name==\"$TAG\")|.assets[].browser_download_url" \
        "[a['browser_download_url'] for r in d if r['tag_name']=='$TAG' for a in r['assets']]" > "$TMP/assets.txt" 2>/dev/null || : > "$TMP/assets.txt"
    ASSET_URL="$(grep -E "$(asset_regex)" "$TMP/assets.txt" | head -n 1 || true)"
    SRC_URL="https://github.com/$REPO/archive/refs/tags/$TAG.tar.gz"
}

# rolling_release BRANCH -> fills VERSION, SHA and ASSET_URL from the branch's rolling CI release (tag ci-<branch>).
# That release is rebuilt by CI on every push, is public, and needs no token. Returns 1 when there is none.
rolling_release() {
    rtag="ci-$(printf '%s' "$1" | tr '/' '-')"
    fetch "$API/releases/tags/$rtag" "$TMP/rolling.json" 2>/dev/null || return 1
    json_get "$TMP/rolling.json" '.assets[]|[.name,.browser_download_url]|@tsv' \
        '["%s\t%s" % (a["name"], a["browser_download_url"]) for a in d.get("assets", [])]' > "$TMP/rassets.tsv" 2>/dev/null || return 1
    [ -s "$TMP/rassets.tsv" ] || return 1
    info="$(awk -F'\t' '$1 == "ci-build.txt" { print $2; exit }' "$TMP/rassets.tsv")"
    [ -n "$info" ] || return 1
    fetch "$info" "$TMP/ci-build.txt" 2>/dev/null || return 1
    VERSION="$(sed -n 's/^version=//p' "$TMP/ci-build.txt" | head -n 1)"
    SHA="$(sed -n 's/^sha=//p' "$TMP/ci-build.txt" | head -n 1)"
    [ -n "$VERSION" ] && [ -n "$SHA" ] || return 1
    safe_ref "$VERSION"; safe_ref "$SHA"
    rx="$(asset_regex)"
    ASSET_URL="$(awk -F'\t' '$1 != "" { print $2 }' "$TMP/rassets.tsv" | grep -E "$rx" | head -n 1 || true)"
    ASSET_IS_ZIP=0
    return 0
}

lookup_branch() {
    if [ "$FALLBACK_BRANCH" != 1 ]; then
        if [ -n "$WANT_LINE" ]; then
            BRANCH="$(branch_of_line "$WANT_LINE")"
            [ -n "$BRANCH" ] || die "release line $WANT_LINE is not listed in supported-releases.txt"
        else
            BRANCH="$(branch_of_channel "$CHANNEL")"
            if [ -z "$BRANCH" ]; then
                case "$CHANNEL" in dev) BRANCH=main ;; *) BRANCH="$CHANNEL" ;; esac
            fi
        fi
    fi
    safe_ref "$BRANCH"
    SRC_NOTE=""

    if rolling_release "$BRANCH"; then
        SRC_URL="https://github.com/$REPO/archive/$SHA.tar.gz"
        if [ "$BINARY_OK" != 1 ] || [ -z "$ASSET_URL" ]; then ASSET_URL=""; fi
        return 0
    fi

    # No rolling release (yet): raw Actions artifacts, which need a token.
    fetch "$API/actions/runs?branch=$BRANCH&status=success&per_page=1" "$TMP/runs.json" || die "could not reach GitHub (actions/runs)"
    TAG="$(json_get "$TMP/runs.json" '.workflow_runs[0].id // empty' '[str(r["id"]) for r in d["workflow_runs"]][:1]' | head -n 1)"
    SHA="$(json_get "$TMP/runs.json" '.workflow_runs[0].head_sha // empty' '[r["head_sha"] for r in d["workflow_runs"]][:1]' | head -n 1)"
    [ -n "$TAG" ] && [ -n "$SHA" ] || die "branch '$BRANCH' has no successful build yet"
    safe_ref "$SHA"

    # <version>.YYYYMMDD.<commit>: version from the source at that commit, date = commit date (UTC)
    BASE=""
    if fetch "$RAW/$SHA/src/longhorn.h" "$TMP/longhorn.h" 2>/dev/null; then
        BASE="$(sed -n 's/^#define LH4051_VERSION "\(.*\)"/\1/p' "$TMP/longhorn.h" | head -n 1)"
    fi
    DAY=""
    if fetch "$API/commits/$SHA" "$TMP/commit.json" 2>/dev/null; then
        DAY="$(json_get "$TMP/commit.json" '.commit.committer.date // empty' '[d["commit"]["committer"]["date"]]' | head -n 1 | cut -c1-10 | tr -d '-')"
    fi
    [ -n "$BASE" ] && [ -n "$DAY" ] || die "could not work out the version of build $SHA on $BRANCH"
    VERSION="$BASE.$DAY.$(printf '%s' "$SHA" | cut -c1-7)"

    SRC_URL="https://github.com/$REPO/archive/$SHA.tar.gz"
    if [ -z "$TOKEN" ]; then
        SRC_NOTE="No rolling CI release for '$BRANCH' yet and no GitHub token (gh auth login, or GH_TOKEN) for the raw CI artifacts; building $BRANCH from source instead."
        return 0
    fi
    fetch "$API/actions/runs/$TAG/artifacts" "$TMP/arts.json" || die "could not list the artifacts of run $TAG"
    case "$OS_RAW" in
        Linux)   ART="lh4051-de-linux-$ART_SUFFIX" ;;
        Darwin)  ART="lh4051-de-macos-$ARCH" ;;
        FreeBSD) ART="lh4051-de-freebsd-$([ "$ARCH" = x86_64 ] && echo x64 || echo "$ARCH")" ;;
        *)       ART="" ;;
    esac
    if [ "$BINARY_OK" = 1 ] && [ -n "$ART" ]; then
        ASSET_URL="$(json_get "$TMP/arts.json" ".artifacts[]|select(.name==\"$ART\" and (.expired|not))|.archive_download_url" \
                     "[a['archive_download_url'] for a in d['artifacts'] if a['name']=='$ART' and not a.get('expired')]" | head -n 1 || true)"
        [ -n "$ASSET_URL" ] && ASSET_IS_ZIP=1
    fi
}

# ---------------------------------------------------------------- go
parse_mode
load_supported
INSTALLED="$(installed_version || true)"
say "LH4051-DE Updater  (mode: $MODE, $TARGET_DESC)"
say "Installed version: ${INSTALLED:-none found}"

case "$KIND" in branch) lookup_branch ;; *) lookup_release ;; esac
[ "$FALLBACK_BRANCH" = 1 ] && lookup_branch
say "Available ($MODE): $VERSION${BRANCH:+  [branch $BRANCH]}"

DOWNGRADE=0
if [ -n "$INSTALLED" ] && [ "$FORCE" != 1 ]; then
    case "$(vcmp "$VERSION" "$INSTALLED")" in
        0) say "LH4051-DE is up to date."; exit 0 ;;
        -1) if [ "$KIND" = exact ]; then DOWNGRADE=1
            else say "Installed version $INSTALLED is newer than $VERSION ($MODE). Use --force to switch anyway."; exit 0; fi ;;
    esac
fi
if [ "$CHECK" = 1 ]; then
    [ "$DOWNGRADE" = 1 ] && say "A different version is available: ${INSTALLED:-none} -> $VERSION" || say "An update is available: ${INSTALLED:-none} -> $VERSION"
    exit 0
fi

confirm "$([ "$DOWNGRADE" = 1 ] && echo "Replace $INSTALLED with" || echo "Install") LH4051-DE $VERSION?" || { say "Cancelled."; exit 1; }

# A variant is only ever installed as a prebuilt installer; never silently replace it with a baseline build.
if [ -n "$VARIANT" ] && [ -n "$SRC_NOTE" ]; then
    die "no rolling CI release for this branch yet and no GitHub token (gh auth login, or GH_TOKEN); variants are never built from source"
fi
if [ -n "$VARIANT" ] && [ "$FORCE_SOURCE" != 1 ] && [ -z "$ASSET_URL" ]; then
    die "no $VARIANT build exists for $VERSION (variants are published by newer releases and CI builds); try another mode or drop --variant"
fi
if [ -n "$VARIANT" ] && [ "$FORCE" != 1 ]; then
    missing="$(cpu_missing "$VARIANT")"
    [ -z "$missing" ] || die "this CPU does not report:$missing, which the $VARIANT build needs (use --force to install anyway)"
fi

# ---------------------------------------------------------------- binary installer
install_binary() {
    if [ "$ASSET_IS_ZIP" = 1 ]; then
        have unzip || die "unzip is needed to unpack the CI artifact"
        fetch "$ASSET_URL" "$TMP/artifact.zip" || die "artifact download failed (is your GitHub token valid?)"
        mkdir -p "$TMP/art" && unzip -q "$TMP/artifact.zip" -d "$TMP/art"
        file="$(find "$TMP/art" -name 'LH4051-DE-Installer-*' | head -n 1)"
        [ -n "$file" ] || die "the artifact contains no installer"
    else
        file="$TMP/$(basename "$ASSET_URL")"
        say "Downloading $(basename "$ASSET_URL")"
        fetch "$ASSET_URL" "$file" || die "download failed"
    fi
    case "$file" in
        *.pkg)
            say "Running the macOS installer (administrator password required)"
            sudo installer -pkg "$file" -target / ;;
        *.run)
            set -- --yes
            [ -n "$PREFIX" ] && set -- "$@" --prefix "$PREFIX"
            sh "$file" "$@" ;;
        *) die "unexpected installer type: $file" ;;
    esac
}

# ---------------------------------------------------------------- source build
is_lfs() {
    [ -n "${LH4051_LFS:-}" ] && return 0
    [ -f /etc/lfs-release ] || [ -f /etc/lfs-version ] && return 0
    [ -r /etc/os-release ] && grep -Eqi '^(ID|NAME)=.?(lfs|linux from scratch)' /etc/os-release && return 0
    return 1
}

find_tool() { # find_tool NAME CANDIDATE...  -> sets the variable NAME to the first candidate that exists
    _var="$1"; shift
    for _c in "$@"; do [ -n "$_c" ] && have "$_c" && { eval "$_var=\$_c"; return 0; }; done
    return 1
}

gtk_ready() {
    PKGCFG=""; find_tool PKGCFG pkg-config pkgconf || return 1
    "$PKGCFG" --atleast-version=4.10 gtk4 2>/dev/null || return 1
    have glib-compile-resources || return 1
}

install_source() {
    [ -n "$SRC_NOTE" ] && say "$SRC_NOTE"
    say "Building from source ($OS_RAW/$ARCH)."
    have tar || die "tar is required"
    CCBIN=""; find_tool CCBIN "${CC:-}" cc gcc clang || die "a C compiler is required (gcc or clang)"
    MAKEBIN=""
    for m in gmake make; do
        have "$m" && "$m" --version 2>/dev/null | grep -q "GNU Make" && { MAKEBIN="$m"; break; }
    done
    [ -n "$MAKEBIN" ] || die "GNU Make is required (install gmake)"

    fetch "$SRC_URL" "$TMP/src.tar.gz" || die "source download failed"
    mkdir -p "$TMP/src" && tar -xzf "$TMP/src.tar.gz" -C "$TMP/src" --strip-components=1

    TARGET="${PREFIX:-/usr/local}"
    SUDO=""
    if [ "$(id -u)" != 0 ] && { [ ! -d "$TARGET" ] || [ ! -w "$TARGET" ]; }; then
        find_tool SUDO sudo doas || SUDO=""
    fi

    # GTK 4.10+ missing? Offer (or, with --bootstrap / on Linux From Scratch, just do) a from-scratch dependency build.
    if [ "$BOOTSTRAP" = 1 ] || ! gtk_ready; then
        if [ "$BOOTSTRAP" = 0 ]; then
            die "GTK 4.10 or newer development files, pkg-config and glib-compile-resources are required (rerun without --no-bootstrap to build them from source)"
        fi
        if [ "$BOOTSTRAP" != 1 ]; then
            if is_lfs; then say "Linux From Scratch detected: GTK 4 and its dependencies will be built from source first."
            elif [ -t 0 ] && [ "$YES" != 1 ]; then
                confirm "GTK 4.10+ was not found. Build the latest GTK 4 and all of its dependencies from source first (this takes a long time)?" \
                    || die "cancelled; install the GTK 4 development files with your package manager, or rerun with --bootstrap"
            else
                die "GTK 4.10+ development files were not found; install them, or rerun with --bootstrap to build them from source"
            fi
        fi
        [ -f "$TMP/src/scripts/lh4051-de-bootstrap" ] || die "this source tree has no scripts/lh4051-de-bootstrap (too old); install GTK 4 yourself"
        say "Bootstrapping GTK 4 and its dependencies into $TARGET (latest upstream versions)."
        $SUDO sh "$TMP/src/scripts/lh4051-de-bootstrap" --prefix "$TARGET" --yes --env-file "$TMP/bootstrap.env" \
            --workdir "${LH4051_BOOTSTRAP_DIR:-${TMPDIR:-/var/tmp}/lh4051-de-bootstrap}" CC="$CCBIN" || die "the dependency bootstrap failed (its logs are in the work directory; rerun to resume)"
        [ -f "$TMP/bootstrap.env" ] && . "$TMP/bootstrap.env"
    fi

    PKGCFG=""; find_tool PKGCFG pkg-config pkgconf || die "pkg-config (or pkgconf) is required"
    "$PKGCFG" --atleast-version=4.10 gtk4 2>/dev/null || die "GTK 4.10 or newer development files are required (found: $("$PKGCFG" --modversion gtk4 2>/dev/null || echo none))"
    have glib-compile-resources || die "glib-compile-resources is required (glib development tools)"

    (
        cd "$TMP/src"
        # Name the build like the CI artifacts do (<version>.YYYYMMDD.<commit>) so the next run can compare.
        "$MAKEBIN" CC="$CCBIN" PKG_VERSION="$VERSION" -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
        $SUDO "$MAKEBIN" CC="$CCBIN" PKG_VERSION="$VERSION" PREFIX="$TARGET" install
    )
}

if [ "$FORCE_SOURCE" = 1 ] || [ "$BINARY_OK" != 1 ] || [ -z "$ASSET_URL" ]; then
    [ "$FORCE_SOURCE" = 1 ] || [ -n "$SRC_NOTE" ] || say "No installer for $OS_RAW/$ARCH in this build."
    install_source
else
    install_binary
fi

say "LH4051-DE $VERSION installed. Restart the shell to use it."

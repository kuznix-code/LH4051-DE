# LH4051-DE Arch Linux package template
pkgname=lh4051-de-git
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Longhorn 4051-inspired desktop environment'
arch=('@ARCH@')
url='https://github.com/kuznix-code/LH4051-DE'
license=('GPL-3.0-or-later')
depends=('gtk4' 'glib2')
optdepends=('gtk4-layer-shell: native Wayland shell surfaces (layer-shell)'
            'labwc: recommended Wayland compositor for the LH4051-DE session'
            'appstream: App Store catalog search')
makedepends=('git' 'base-devel' 'pkgconf' 'gtk4-layer-shell')
provides=('lh4051-de')
conflicts=('lh4051-de')
source=("git+https://github.com/kuznix-code/LH4051-DE.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/LH4051-DE"

    # Git snapshot version: <latest-tag>.r<commits-since-tag>.<short-head>
    local tag commits short
    tag="$(git describe --tags --abbrev=0 2>/dev/null || printf '0.0.0')"
    tag="${tag#v}"
    tag="$(printf '%s' "$tag" | sed 's/[^A-Za-z0-9.+_]/./g')"
    commits="$(git rev-list --count "$(git describe --tags --abbrev=0 2>/dev/null || true)"..HEAD 2>/dev/null || printf '0')"
    short="$(git rev-parse --short=7 HEAD)"
    printf '%s.r%s.%s' "$tag" "$commits" "$short"
}

build() {
    cd "$srcdir/LH4051-DE"
    make PREFIX=/usr
}

package() {
    cd "$srcdir/LH4051-DE"
    make DESTDIR="$pkgdir" PREFIX="/usr" install
}

# Development snapshot (make dist-arch-git). Stable releases use PKGBUILD.in.

# LH4051-DE RPM packages (built from source by scripts/ci-package-build.sh).
# Placeholders: @VERSION@ (RPM-safe version, "~" marks pre-releases), @PKG_VERSION@ (version stamp), @DATE@ (changelog date).
Name:           LH4051-DE
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Longhorn 4051-inspired desktop environment
License:        GPL-3.0-or-later
URL:            https://github.com/kuznix-code/LH4051-DE
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconfig
BuildRequires:  pkgconfig(gtk4) >= 4.10
BuildRequires:  glib2-devel
BuildRequires:  gtk4-layer-shell-devel
Requires:       LH4051-DE-data = %{version}-%{release}
Requires:       LH4051-DE-session = %{version}-%{release}
Requires:       LH4051-DE-session-wayland = %{version}-%{release}
Recommends:     labwc
Suggests:       appstream

# No debuginfo/debugsource subpackages; only the packages below are produced.
%global debug_package %{nil}

%description
LH4051-DE is a desktop shell inspired by Windows Longhorn build 4051, written
in C on top of GTK 4. It provides the desktop, panel, sidebar, start menu, file
manager, settings and app store, plus a session wrapper that starts a
compositor and the shell.

This package contains the desktop shell and its session wrapper. The updater
and dependency bootstrap tools are available as separate optional packages.

%package -n LH4051-DE-data
Summary:        Longhorn 4051-inspired desktop environment - data files
BuildArch:      noarch

%description -n LH4051-DE-data
Architecture-independent data files for LH4051-DE: the application menu entry.

%package -n LH4051-DE-session
Summary:        Longhorn 4051-inspired desktop environment - X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
# Default window manager for the X11 session (the session script tries openbox first).
Requires:       openbox

%description -n LH4051-DE-session
Adds the "LH4051-DE" X11 session entry to the login manager. The session runs
the shell on top of the default window manager.

%package -n LH4051-DE-session-xfwm4
Summary:        Longhorn 4051-inspired desktop environment - Xfwm4 X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       xfwm4

%description -n LH4051-DE-session-xfwm4
Adds the "LH4051-DE (Xfwm4)" X11 session entry and starts the shell with xfwm4.

%package -n LH4051-DE-session-marco
Summary:        Longhorn 4051-inspired desktop environment - Marco X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       marco

%description -n LH4051-DE-session-marco
Adds the "LH4051-DE (Marco)" X11 session entry and starts the shell with marco.

%package -n LH4051-DE-session-metacity
Summary:        Longhorn 4051-inspired desktop environment - Metacity X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       metacity

%description -n LH4051-DE-session-metacity
Adds the "LH4051-DE (Metacity)" X11 session entry and starts the shell with metacity.

%package -n LH4051-DE-session-icewm
Summary:        Longhorn 4051-inspired desktop environment - Icewm X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       icewm

%description -n LH4051-DE-session-icewm
Adds the "LH4051-DE (Icewm)" X11 session entry and starts the shell with icewm.

%package -n LH4051-DE-session-fluxbox
Summary:        Longhorn 4051-inspired desktop environment - Fluxbox X11 session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       fluxbox

%description -n LH4051-DE-session-fluxbox
Adds the "LH4051-DE (Fluxbox)" X11 session entry and starts the shell with fluxbox.

%package -n LH4051-DE-session-wayland
Summary:        Longhorn 4051-inspired desktop environment - Wayland session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       labwc

%description -n LH4051-DE-session-wayland
Adds the "LH4051-DE (Wayland)" session entry to the login manager. The session
runs the shell on top of the labwc compositor.

%package -n LH4051-DE-session-wayland-sway
Summary:        Longhorn 4051-inspired desktop environment - Sway Wayland session
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}
Requires:       sway

%description -n LH4051-DE-session-wayland-sway
Adds the "LH4051-DE (Wayland, Sway)" session entry and starts the shell with Sway.

%package -n LH4051-DE-sessions-x11-all
Summary:        All LH4051-DE X11 sessions
BuildArch:      noarch
Requires:       LH4051-DE-session = %{version}-%{release}
Requires:       LH4051-DE-session-xfwm4 = %{version}-%{release}
Requires:       LH4051-DE-session-marco = %{version}-%{release}
Requires:       LH4051-DE-session-metacity = %{version}-%{release}
Requires:       LH4051-DE-session-icewm = %{version}-%{release}
Requires:       LH4051-DE-session-fluxbox = %{version}-%{release}

%description -n LH4051-DE-sessions-x11-all
Meta-package installing every available LH4051-DE X11 session.

%package -n LH4051-DE-sessions-wayland-all
Summary:        All LH4051-DE Wayland sessions
BuildArch:      noarch
Requires:       LH4051-DE-session-wayland = %{version}-%{release}
Requires:       LH4051-DE-session-wayland-sway = %{version}-%{release}

%description -n LH4051-DE-sessions-wayland-all
Meta-package installing every available LH4051-DE Wayland session.

%package -n LH4051-DE-sessions-all
Summary:        All LH4051-DE sessions
BuildArch:      noarch
Requires:       LH4051-DE-sessions-x11-all = %{version}-%{release}
Requires:       LH4051-DE-sessions-wayland-all = %{version}-%{release}

%description -n LH4051-DE-sessions-all
Meta-package installing every available LH4051-DE X11 and Wayland session.

%package -n LH4051-DE-updater
Summary:        LH4051-DE updater
BuildArch:      noarch
Requires:       LH4051-DE = %{version}-%{release}

%description -n LH4051-DE-updater
Optional command-line updater for downloading and installing LH4051-DE releases
or building the project from source where supported.

%package -n LH4051-DE-bootstrap
Summary:        LH4051-DE dependency bootstrap tool
BuildArch:      noarch

%description -n LH4051-DE-bootstrap
Optional helper for building and installing GTK 4 and its dependencies from
source into a chosen prefix.

%prep
%autosetup -n lh4051-de-%{version}

%build
%make_build PREFIX=%{_prefix} PKG_VERSION=@PKG_VERSION@ \
    CFLAGS="%{optflags}" LDFLAGS="%{build_ldflags}" all sessions

%check
./build/linux-gcc/lh4051-de --version

%install
%make_install PREFIX=%{_prefix} PKG_VERSION=@PKG_VERSION@ \
    CFLAGS="%{optflags}" LDFLAGS="%{build_ldflags}"
make DESTDIR=%{buildroot} PREFIX=%{_prefix} install-updater install-bootstrap

%files
%license LICENSE
%doc README.md
